@implements IDisposable

@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IReactionService ReactionService

<AuthorizeView>
    <Authorized>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-sm @(currentReaction == ReactionType.Like ? "btn-primary" : "btn-outline-secondary")"
                    disabled="@isLoading"
                    @onclick="() => HandleReactionAsync(ReactionType.Like)">
                👍 (@GetReactionCount(ReactionType.Like))
            </button>
            <button class="btn btn-sm @(currentReaction == ReactionType.Dislike ? "btn-primary" : "btn-outline-secondary")"
                    disabled="@isLoading"
                    @onclick="() => HandleReactionAsync(ReactionType.Dislike)">
                👎 (@GetReactionCount(ReactionType.Dislike))
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-sm btn-outline-secondary" disabled>
                👍 (@GetReactionCount(ReactionType.Like))
            </button>
            <button class="btn btn-sm btn-outline-secondary" disabled>
                👎 (@GetReactionCount(ReactionType.Dislike))
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <small class="text-danger">@errorMessage</small>
}

@code {
    [Parameter]
    public int ContentId { get; set; }

    [Parameter]
    public ContentType ContentType { get; set; }

    [Parameter]
    public Dictionary<ReactionType, int> ReactionCounts { get; set; } = [];

    private ReactionType? currentReaction;
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserReactionAsync(
                await AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged +=
            OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(
        Task<AuthenticationState> authenticationStateTask)
    {
        await InvokeAsync(async () =>
        {
            await LoadUserReactionAsync(await authenticationStateTask);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -=
            OnAuthenticationStateChanged;
    }

    private async Task LoadUserReactionAsync(AuthenticationState authState)
    {
        currentReaction = null;
        errorMessage = null;

        if (authState.User.Identity?.IsAuthenticated is not true)
            return;
        
        try
        {
            currentReaction = await ReactionService.GetUserReactionAsync(
                ContentId,
                ContentType);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized =>
                    "Your session has expired. Please log in again.",

                System.Net.HttpStatusCode.Forbidden =>
                    "You are not allowed to view this reaction.",

                System.Net.HttpStatusCode.NotFound =>
                    "The requested content could not be found.",

                _ => "Could not communicate with the server."
            };
        }
                catch (Exception)
        {
            errorMessage = "Could not load your reaction.";
        }
    }

    private async Task HandleReactionAsync(ReactionType selectedReaction)
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            if (currentReaction == selectedReaction)
            {
                // Clicking the selected reaction removes it.
                await ReactionService.RemoveReactionAsync(
                    new DeleteReactionRequest
                    {
                        ContentId = ContentId,
                        ContentType = ContentType
                    });

                currentReaction = null;
                ReactionCounts[selectedReaction]--;
            }
            else if (currentReaction.HasValue)
            {
                // Switch between Like and Dislike.
                await ReactionService.UpdateReactionAsync(
                    new UpdateReactionRequest
                    {
                        ContentId = ContentId,
                        ContentType = ContentType,
                        ReactionType = selectedReaction
                    });

                ReactionCounts[currentReaction.Value] =
                    GetReactionCount(currentReaction.Value) - 1;

                ReactionCounts[selectedReaction] =
                    GetReactionCount(selectedReaction) + 1;

                currentReaction = selectedReaction;
            }
            else
            {
                // Create a new reaction.
                await ReactionService.AddReactionAsync(
                    new CreateReactionRequest
                    {
                        ContentId = ContentId,
                        ContentType = ContentType,
                        ReactionType = selectedReaction
                    });

                currentReaction = selectedReaction;
                ReactionCounts[selectedReaction] =
                    GetReactionCount(selectedReaction) + 1;
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not update your reaction.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetReactionCount(ReactionType type)
    {
        return ReactionCounts.TryGetValue(type, out int count)
            ? count
            : 0;
    }
}