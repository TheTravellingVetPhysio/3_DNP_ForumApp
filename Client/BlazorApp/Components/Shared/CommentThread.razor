@using ApiContracts

<div class="card mb-3">
    <div class="card-body">
        <p>@Comment.Body</p>

        <small class="text-muted">
            By
            <a href="/users/@Comment.UserId">@Comment.Username</a>
            · @Comment.CreatedAt.ToLocalTime().ToString("g")
        </small>

        <div class="mt-2">
            <ReactionButtons ContentId="@Comment.CommentId"
                             ContentType="ContentType.Comment"
                             ReactionCounts="@Comment.ReactionCounts" />
        </div>

        <button class="btn btn-link btn-sm"
                @onclick="ToggleReplyForm">
            @(showReplyForm ? "Cancel reply" : "Reply")
        </button>

        @if (showReplyForm)
        {
            <div class="mt-3 ms-4">
                <CreateComment PostId="@PostId"
                               ParentCommentId="@Comment.CommentId"
                               OnCommentCreated="HandleCommentCreated" />
            </div>
        }
    </div>
</div>

@{
    var replies = AllComments
        .Where(c => c.ParentCommentId == Comment.CommentId)
        .ToList();
}

@if (replies.Count > 0)
{ 
    <div class="ms-4">
    @foreach (CommentDetailsDTO reply in replies)
        {
        <CommentThread Comment="reply"
        AllComments="AllComments"
        PostId="PostId"
        OnCommentCreated="OnCommentCreated"
        @key="reply.CommentId" />
        } </div>
}

@code {
    [Parameter, EditorRequired]
    public CommentDetailsDTO Comment { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<CommentDetailsDTO> AllComments { get; set; } = [];

    [Parameter]
    public int PostId { get; set; }

    [Parameter]
    public EventCallback OnCommentCreated { get; set; }

    private bool showReplyForm;

    private void ToggleReplyForm()
    {
        showReplyForm = !showReplyForm;
    }

    private async Task HandleCommentCreated()
    {
        showReplyForm = false;
        await OnCommentCreated.InvokeAsync();
    }

}
